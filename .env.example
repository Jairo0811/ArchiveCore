# Copy to .env and fill in every required value. Never commit .env.
# There are no default credentials: generate your own secrets, for example
#   openssl rand -base64 32

# Required. SQL Server "sa" password (8+ chars with upper, lower, digit and symbol).
ARCHIVECORE_SQL_SA_PASSWORD=

# Required. JWT HMAC signing key, at least 32 characters.
ARCHIVECORE_JWT_SIGNING_KEY=

# Optional one-time first-administrator bootstrap (only runs while dbo.Users is empty).
# Enable it for the first start, then set it back to false and clear the password.
ARCHIVECORE_BOOTSTRAP_ADMIN_ENABLED=false
ARCHIVECORE_BOOTSTRAP_ADMIN_FIRST_NAME=ArchiveCore
ARCHIVECORE_BOOTSTRAP_ADMIN_LAST_NAME=Administrator
ARCHIVECORE_BOOTSTRAP_ADMIN_EMAIL=
ARCHIVECORE_BOOTSTRAP_ADMIN_PASSWORD=

# Optional overrides.
# ARCHIVECORE_WEB_PORT=5173
# ARCHIVECORE_SQL_PORT=1433
# ARCHIVECORE_ALLOWED_HOSTS=localhost;127.0.0.1
# Set to false only when browsing the stack over plain HTTP from a host other than localhost.
# ARCHIVECORE_REFRESH_COOKIE_SECURE=true
